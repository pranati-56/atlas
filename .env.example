# Atlas frontend.  Copy to .env.local and adjust.
#
# This is the whole of the frontend's configuration, and it holds no secrets by
# design: NEXT_PUBLIC_* is inlined into the JavaScript bundle and served to
# every visitor. Anything private belongs in api/.env instead, behind the API —
# database credentials, provider keys and connector tokens all live there.

# Where the FastAPI service is listening. Leave it unset for local development
# and the client falls back to http://localhost:8000.
#
# In production this is the API's public origin, and it must also appear in
# ATLAS_CORS_ORIGINS on the backend. The session is a cookie, so a mismatch
# shows up as every request failing preflight rather than as a clean 401.
NEXT_PUBLIC_ATLAS_API=http://localhost:8000
