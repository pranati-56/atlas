# Atlas backend.  Copy to api/.env and fill in.
#
# Read only by the FastAPI service and the worker. The frontend is a separate
# deployable with its own .env.local at the repo root, and the only thing it
# needs is the URL of this service — no key in this file ever reaches a browser.

# ─── database (Supabase) ────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI.
# Use the *session* pooler on port 5432. The transaction pooler on 6543 cannot
# hold the advisory lock the migrator takes, and breaks the job queue's
# SELECT ... FOR UPDATE SKIP LOCKED, because it may hand each statement a
# different backend.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Pool ceiling per process. The API and the worker each open their own, so keep
# the sum under the Supabase plan's connection limit.
DATABASE_POOL_MAX=10

# ─── models ─────────────────────────────────────────────────────────────────
# Gemini is the default on both sides. 2.5 Flash is cheap enough to run the
# agentic loop without watching the meter, and gemini-embedding-001 is the one
# embedding model here that lets you ask for a specific output width — which is
# what keeps ATLAS_EMBEDDING_DIM and the vector(768) column in agreement.
#
# Only this key is required. The provider is inferred from the model id, so
# moving to OpenAI or Anthropic is an id change here, not a code change.
GEMINI_API_KEY=

# Optional — set only if you point the model ids below at them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supported ids are in atlas/llm/registry.py.
ATLAS_GENERATION_MODEL=gemini-2.5-flash
ATLAS_EMBEDDING_MODEL=gemini-embedding-001

# MUST equal the vector(N) width in db/migrations/001_core.sql. Changing it
# invalidates every stored vector — bump ATLAS_EMBEDDING_VERSION with it and the
# reindex job re-embeds in the background instead of breaking search.
ATLAS_EMBEDDING_DIM=768
ATLAS_EMBEDDING_VERSION=1

# ─── http ───────────────────────────────────────────────────────────────────
# Origins allowed to call this API with credentials. The session is a cookie, so
# the CORS spec rejects "*" and an explicit list is the only option. Add your
# deployed frontend's origin here.
ATLAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3400,http://127.0.0.1:3400

# ─── auth ───────────────────────────────────────────────────────────────────
# Signs the session cookie. Generate with:  openssl rand -base64 48
ATLAS_SESSION_SECRET=

# Development convenience: authenticates every request as this user with no
# login. NEVER set in production — it bypasses the permission filter, which is
# the whole point of the retrieval layer.
# ATLAS_DEV_USER=alice@acme.example

# ─── retrieval defaults ─────────────────────────────────────────────────────
ATLAS_TOP_K=8
ATLAS_CANDIDATES=60
ATLAS_ALPHA=0.5
ATLAS_RRF_K=60

# ─── agentic loop budget ────────────────────────────────────────────────────
# Hard caps. The loop stops at whichever binds first and records which one.
ATLAS_MAX_ROUNDS=4
ATLAS_MAX_TOOL_CALLS=8
ATLAS_MAX_QUERY_TOKENS=120000
ATLAS_MAX_QUERY_COST_USD=0.25
ATLAS_MAX_QUERY_MS=90000

# ─── worker ─────────────────────────────────────────────────────────────────
ATLAS_WORKER_CONCURRENCY=4
ATLAS_WORKER_POLL_MS=1000
ATLAS_JOB_LEASE_SECONDS=300

# ─── connectors (all optional) ──────────────────────────────────────────────
# Per-source credentials in sources.config take precedence over these. Setting
# them here is the shortcut when one workspace serves the whole tenant.

# Fine-grained PAT with Contents: read.
GITHUB_TOKEN=

# Internal integration token. Share the pages or teamspaces with it or it sees
# nothing — Notion's own sharing model is the first permission filter.
NOTION_TOKEN=

# Bot token (xoxb-). Scopes: channels:read, channels:history, users:read.
SLACK_BOT_TOKEN=

# Drive is OAuth, not a static key. The per-source refresh token lives on the
# source; these identify the app it was issued to. Scope: drive.readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
